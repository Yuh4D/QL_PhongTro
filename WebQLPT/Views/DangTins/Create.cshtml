@model WebQLPT.Models.DangTin

@{
    ViewData["Title"] = "Đăng tin";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Đăng tin phòng trọ
        </h2>

        <p class="text-muted mb-0">
            Tạo bài đăng mới cho phòng trọ
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <form asp-action="Create">

            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="TieuDe"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TieuDe"
                           class="form-control"
                           placeholder="Nhập tiêu đề..." />

                    <span asp-validation-for="TieuDe"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Gia"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Gia"
                           class="form-control"
                           placeholder="VD: 1500000" />

                    <span asp-validation-for="Gia"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="NoiDung"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="NoiDung"
                              rows="5"
                              class="form-control"
                              placeholder="Mô tả chi tiết..."></textarea>

                    <span asp-validation-for="NoiDung"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="HinhAnh"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="HinhAnh"
                           class="form-control"
                           placeholder="Link ảnh..." />

                    <span asp-validation-for="HinhAnh"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="PhongTroId"
                           class="form-label fw-semibold">
                        Phòng trọ
                    </label>

                    <select asp-for="PhongTroId"
                            class="form-select"
                            asp-items="ViewBag.PhongTroId">
                    </select>

                </div>

                <div class="col-md-6">

                    <label asp-for="ChuTroId"
                           class="form-label fw-semibold">
                        Chủ trọ
                    </label>

                    <select asp-for="ChuTroId"
                            class="form-select"
                            asp-items="ViewBag.ChuTroId">
                    </select>

                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-check-circle"></i>
                    Đăng tin

                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">

                    Hủy

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

