@model WebQLPT.Models.DangTin

@{
    ViewData["Title"] = "Chỉnh sửa bài đăng";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-pencil-square me-2"></i>
            Chỉnh sửa bài đăng
        </h2>

        <p class="text-muted mb-0">
            Cập nhật thông tin bài đăng phòng trọ
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <form asp-action="Edit"
              enctype="multipart/form-data">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="TieuDe"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TieuDe"
                           class="form-control" />

                    <span asp-validation-for="TieuDe"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Gia"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Gia"
                           class="form-control" />

                    <span asp-validation-for="Gia"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="NoiDung"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="NoiDung"
                              rows="5"
                              class="form-control"></textarea>

                    <span asp-validation-for="NoiDung"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Hình ảnh mới
                    </label>

                    <input type="file"
                           name="ImageFile"
                           class="form-control" />

                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <div class="col-12">

                            <img src="@Model.HinhAnh"
                                 class="img-thumbnail rounded"
                                 style="max-height:250px;" />

                        </div>
                    }

                </div>

                

                <div class="col-md-6">

                    <label asp-for="NgayDang"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="NgayDang"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayDang"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="PhongTroId"
                           class="form-label fw-semibold">
                        Phòng trọ
                    </label>

                    <select asp-for="PhongTroId"
                            class="form-select"
                            asp-items="ViewBag.PhongTroId">
                    </select>

                </div>

                <div class="col-md-6">

                    <label asp-for="ChuTroId"
                           class="form-label fw-semibold">
                        Chủ trọ
                    </label>

                    <select asp-for="ChuTroId"
                            class="form-select"
                            asp-items="ViewBag.ChuTroId">
                    </select>

                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save"></i>
                    Lưu thay đổi

                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">

                    Hủy

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

