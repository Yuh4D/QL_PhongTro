@model WebQLPT.Models.KhachThue

@{
    ViewData["Title"] = "Xóa khách thuê";
    Layout = "_LayoutAdmin";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card border-0 shadow rounded-4">

            <div class="card-body p-5">

                <div class="text-center mb-4">

                    <div class="display-5 text-danger mb-3">
                        ⚠️
                    </div>

                    <h2 class="fw-bold text-danger">
                        Xóa khách thuê
                    </h2>

                    <p class="text-muted">
                        Bạn có chắc chắn muốn xóa khách thuê này?
                    </p>

                </div>

                <div class="border rounded-4 p-4 bg-light">

                    <div class="mb-3">
                        <span class="text-muted">Tên khách:</span>
                        <div class="fw-semibold">@Model.TenKhach</div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted">Số điện thoại:</span>
                        <div class="fw-semibold">@Model.SoDienThoai</div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted">CCCD:</span>
                        <div class="fw-semibold">@Model.CCCD</div>
                    </div>

                    <div>
                        <span class="text-muted">Phòng:</span>
                        <div class="fw-semibold">
                            @Model.PhongTro?.TenPhong
                        </div>
                    </div>

                </div>

                <form asp-action="Delete" class="mt-4">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2 justify-content-center">

                        <button type="submit"
                                class="btn btn-danger px-4">

                            🗑️ Xóa

                        </button>

                        <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                            Hủy

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>