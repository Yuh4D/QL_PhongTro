@model WebQLPT.ViewModels.CreateKhachThueViewModel

@{
    ViewData["Title"] = "Thêm khách thuê";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Thêm khách thuê
        </h2>

        <p class="text-muted mb-0">
            Tạo mới thông tin khách thuê và tài khoản đăng nhập
        </p>
    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row">

                <!-- LEFT -->
                <div class="col-md-6">

                    <h5 class="fw-bold mb-3">
                        Thông tin khách thuê
                    </h5>

                    <div class="mb-3">

                        <label asp-for="TenKhach"
                               class="form-label fw-semibold"></label>

                        <input asp-for="TenKhach"
                               class="form-control" />

                        <span asp-validation-for="TenKhach"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="SoDienThoai"
                               class="form-label fw-semibold"></label>

                        <input asp-for="SoDienThoai"
                               class="form-control" />

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="CCCD"
                               class="form-label fw-semibold"></label>

                        <input asp-for="CCCD"
                               class="form-control" />

                        <span asp-validation-for="CCCD"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="NgayThue"
                               class="form-label fw-semibold"></label>

                        <input asp-for="NgayThue"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="NgayThue"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PhongTroId"
                               class="form-label fw-semibold"></label>

                        <select asp-for="PhongTroId"
                                class="form-select"
                                asp-items="ViewBag.PhongTroId">

                            <option value="">
                                -- Chọn phòng --
                            </option>

                        </select>

                        <span asp-validation-for="PhongTroId"
                              class="text-danger small"></span>

                    </div>

                </div>

                <!-- RIGHT -->
                <div class="col-md-6">

                    <h5 class="fw-bold mb-3">
                        Tài khoản đăng nhập
                    </h5>

                    <div class="mb-3">

                        <label asp-for="Username"
                               class="form-label fw-semibold"></label>

                        <input asp-for="Username"
                               class="form-control" />

                        <span asp-validation-for="Username"
                              class="text-danger small"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label fw-semibold"></label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="Password"
                              class="text-danger small"></span>

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-success px-4">

                    <i class="bi bi-check-circle"></i>
                    Thêm khách thuê

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Hủy

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
            icon: 'error',
            title: 'Không thể thêm!',
            text: '@Html.Raw(TempData["Error"])',
            confirmButtonColor: '#dc3545'
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
            icon: 'success',
            title: 'Thành công!',
            text: '@Html.Raw(TempData["Success"])',
            confirmButtonColor: '#198754'
            });
        </script>
    }

}