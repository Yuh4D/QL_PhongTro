@model WebQLPT.Models.KhachThue

@{
    ViewData["Title"] = "Create";
}

<h1>Thêm khách thuê</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="TenKhach" class="control-label"></label>
                <input asp-for="TenKhach" class="form-control" />
                <span asp-validation-for="TenKhach" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoDienThoai" class="control-label"></label>
                <input asp-for="SoDienThoai" class="form-control" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CCCD" class="control-label"></label>
                <input asp-for="CCCD" class="form-control" />
                <span asp-validation-for="CCCD" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NgayThue" class="control-label"></label>
                <input asp-for="NgayThue" type="date" class="form-control" />
                <span asp-validation-for="NgayThue" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhongTroId" class="control-label"></label>
                <select asp-for="PhongTroId" class="form-control" asp-items="ViewBag.PhongTroId"></select>
                <span asp-validation-for="PhongTroId" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Thêm" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index">Quay lại</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Import SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
            icon: 'error',
            title: 'Bạn không thể chọn phòng này!',
            text: @Html.Raw(Json.Serialize(TempData["Error"])),
            confirmButtonText: 'Đã hiểu',
            confirmButtonColor: '#e74c3c',
            background: '#fff',
            backdrop: 'rgba(0,0,0,0.4)'
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
            icon: 'success',
            title: 'Thành công!',
            text: @Html.Raw(Json.Serialize(TempData["Success"])),
            confirmButtonText: 'OK',
            confirmButtonColor: '#3085d6'
            });
        </script>
    }
}

