@model WebQLPT.Models.KhachThue

@{
    ViewData["Title"] = "Cập nhật khách thuê";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">✏️ Cập nhật khách thuê</h2>
        <p class="text-muted mb-0">
            Chỉnh sửa thông tin khách thuê
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Quay lại
    </a>

</div>

<div class="card shadow border-0 rounded-4">
    <div class="card-body p-4">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="TenKhach" class="form-label fw-semibold"></label>
                    <input asp-for="TenKhach" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                    <input asp-for="SoDienThoai" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="CCCD" class="form-label fw-semibold"></label>
                    <input asp-for="CCCD" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="NgayThue" class="form-label fw-semibold"></label>
                    <input asp-for="NgayThue"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="PhongTroId" class="form-label fw-semibold"></label>

                    <select asp-for="PhongTroId"
                            class="form-select"
                            asp-items="ViewBag.PhongTroId">
                    </select>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button type="submit" class="btn btn-primary">
                    💾 Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Hủy
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}