@model WebQLPT.Models.KhachThue

@{
    ViewData["Title"] = "Chi tiết khách thuê";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">👤 Chi tiết khách thuê</h2>
        <p class="text-muted mb-0">
            Thông tin chi tiết khách thuê
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Quay lại
    </a>

</div>

<div class="card shadow border-0 rounded-4">

    <div class="card-body p-4">

        <div class="row g-4">

            <div class="col-md-6">
                <label class="text-muted small">Tên khách</label>
                <div class="fw-semibold">@Model.TenKhach</div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small">Số điện thoại</label>
                <div class="fw-semibold">@Model.SoDienThoai</div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small">CCCD</label>
                <div class="fw-semibold">@Model.CCCD</div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small">Ngày thuê</label>
                <div class="fw-semibold">
                    @(Model.NgayThue?.ToString("dd/MM/yyyy"))
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small">Phòng trọ</label>
                <div class="fw-semibold">
                    @Model.PhongTro?.TenPhong
                </div>
            </div>

        </div>

    </div>

    <div class="card-footer bg-white border-0 p-4">

        <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

            ✏️ Chỉnh sửa

        </a>

    </div>

</div>