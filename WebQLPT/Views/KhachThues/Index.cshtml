@model IEnumerable<WebQLPT.Models.KhachThue>

@{
    ViewData["Title"] = "Danh sách khách thuê";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-person-fill me-2"></i>
                 Danh sách khách thuê
        </h2>

        <p class="text-muted mb-0">
            Quản lý người thuê phòng trong hệ thống
        </p>
    </div>

    <a asp-action="Create"
           class="btn btn-success">

        <i class="bi bi-plus-circle"></i>
           Thêm khách thuê

    </a>

</div>

<form method="get"
      asp-action="Index"
      class="row g-2 mb-4">

    <div class="col-md-4">

        <input type="text"
               name="keyword"
               class="form-control"
               placeholder="Tìm khách..." />

    </div>

    <div class="col-auto">

        <button type="submit"
                class="btn btn-primary">
            🔍 Tìm kiếm
        </button>

    </div>

</form>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead class="table-dark">

                <tr>
                    <th>Tên khách</th>
                    <th>Số điện thoại</th>
                    <th>CCCD</th>
                    <th>Ngày thuê</th>
                    <th>Ngày kết thúc</th>
                    <th>Trạng thái</th>
                    <th>Phòng</th>
                    <th width="220">Thao tác</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @item.TenKhach
                        </td>

                        <td>
                            @item.SoDienThoai
                        </td>

                        <td>
                            @item.CCCD
                        </td>

                        <td>
                            @(item.NgayThue.HasValue
                                ? item.NgayThue.Value.ToString("dd/MM/yyyy")
                                : "")
                        </td>

                        <td>
                            @(item.NgayKetThuc.HasValue
                                ? item.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                                : "Chưa kết thúc")
                        </td>

                        <td>

                            @if (item.DangO)
                            {
                                <span class="badge bg-success">
                                    Đang ở
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Đã rời
                                </span>
                            }

                        </td>

                        <td>
                            @item.PhongTro?.TenPhong
                        </td>

                        <td>

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
									<i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
									<i class="bi bi-pencil-square"></i>
                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
									<i class="bi bi-trash"></i>
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>