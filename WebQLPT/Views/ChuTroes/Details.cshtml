@model WebQLPT.Models.ChuTro

@{
    ViewData["Title"] = "Chi tiết chủ trọ";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">👤 Chi tiết chủ trọ</h2>
            <p class="text-muted mb-0">
                Thông tin đầy đủ của chủ trọ
            </p>
        </div>

        <a asp-action="Index"
               class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <div class="row mb-4">

                <div class="col-md-6">
                    <label class="text-muted small">Tên chủ trọ</label>

                    <div class="fw-semibold fs-5">
                        @Model.TenChuTro
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Số điện thoại</label>

                    <div class="fw-semibold fs-5">
                        @Model.SoDienThoai
                    </div>
                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">
                    <label class="text-muted small">Email</label>

                    <div class="fw-semibold">
                        @Model.Email
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Địa chỉ</label>

                    <div class="fw-semibold">
                        @Model.DiaChi
                    </div>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                    ✏️ Chỉnh sửa

                </a>

                <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">

                    🗑 Xóa

                </a>

            </div>

        </div>

    </div>

</div>