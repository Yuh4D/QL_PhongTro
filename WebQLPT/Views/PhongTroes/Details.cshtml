@model WebQLPT.Models.PhongTro

@{
    ViewData["Title"] = "Chi tiết phòng";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                🏠 Chi tiết phòng trọ
            </h2>

            <p class="text-muted mb-0">
                Thông tin chi tiết của phòng
            </p>
        </div>

        <a asp-action="Index"
               class="btn btn-outline-secondary">

            ← Quay lại

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="text-muted small">
                        Tên phòng
                    </label>

                    <h5 class="fw-bold">
                        @Model.TenPhong
                    </h5>

                </div>

                <div class="col-md-6">

                    <label class="text-muted small">
                        Giá phòng
                    </label>

                    <h5 class="text-danger fw-bold">

                        @Model.Gia.ToString("N0",
                                 new System.Globalization.CultureInfo("vi-VN")) đ

                    </h5>

                </div>

                <div class="col-md-6">

                    <label class="text-muted small">
                        Trạng thái
                    </label>

                    <div>

                        @if (Model.TrangThai == "Trống")
                        {
                            <span class="badge bg-success">
                                Trống
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Đã thuê
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted small">
                        Chủ trọ
                    </label>

                    <h6 class="fw-semibold">
                        @Model.ChuTro?.TenChuTro
                    </h6>

                </div>

                <div class="col-12">

                    <label class="text-muted small">
                        Mô tả
                    </label>

                    <div class="border rounded p-3 bg-light">

                        @(string.IsNullOrEmpty(Model.MoTa)
                            ? "Không có mô tả"
                            : Model.MoTa)

                    </div>

                </div>

            </div>

            <div class="mt-4">

                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning text-white">

                    ✏️ Chỉnh sửa

                </a>

            </div>

        </div>

    </div>

</div>