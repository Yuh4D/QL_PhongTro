@model WebQLPT.Models.PhongTro

@{
    ViewData["Title"] = "Chỉnh sửa phòng";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            ✏️ Chỉnh sửa phòng trọ
        </h2>

        <p class="text-muted mb-0">
            Cập nhật thông tin phòng
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-4">

                    <!-- TÊN PHÒNG -->
                    <div class="col-md-6">

                        <label asp-for="TenPhong"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="TenPhong"
                               class="form-control" />

                        <span asp-validation-for="TenPhong"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- GIÁ -->
                    <div class="col-md-6">

                        <label asp-for="Gia"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Gia"
                               class="form-control" />

                        <span asp-validation-for="Gia"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- TRẠNG THÁI -->
                    <div class="col-md-6">

                        <label asp-for="TrangThai"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="TrangThai"
                                class="form-select">

                            <option value="Trống">
                                Trống
                            </option>

                            <option value="Đã thuê">
                                Đã thuê
                            </option>

                        </select>

                    </div>

                    <!-- CHỦ TRỌ -->
                    @if (User.IsInRole("admin"))
                    {
                        <div class="col-md-6">

                            <label asp-for="ChuTroId"
                                   class="form-label fw-semibold">
                                Chủ trọ
                            </label>

                            <select asp-for="ChuTroId"
                                    class="form-select"
                                    asp-items="ViewBag.ChuTroId">
                            </select>

                        </div>
                    }

                    <!-- MÔ TẢ -->
                    <div class="col-12">

                        <label asp-for="MoTa"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="MoTa"
                                  rows="5"
                                  class="form-control"></textarea>

                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning text-white">

                        💾 Lưu thay đổi

                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        Quay lại

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}