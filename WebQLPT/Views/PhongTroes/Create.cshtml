@model WebQLPT.Models.PhongTro

@{
    ViewData["Title"] = "Thêm phòng trọ";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

   
    <div class="mb-4">

        <h2 class="fw-bold">
            ➕ Thêm phòng trọ
        </h2>

        <p class="text-muted mb-0">
            Nhập thông tin phòng mới vào hệ thống
        </p>

    </div>

   
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-4">

                    
                    <div class="col-md-6">

                        <label asp-for="TenPhong"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="TenPhong"
                               class="form-control"
                               placeholder="Ví dụ: Phòng 101" />

                        <span asp-validation-for="TenPhong"
                              class="text-danger small">
                        </span>

                    </div>

                    
                    <div class="col-md-6">

                        <label asp-for="Gia"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Gia"
                               class="form-control"
                               placeholder="Ví dụ: 2500000" />

                        <span asp-validation-for="Gia"
                              class="text-danger small">
                        </span>

                    </div>

                   
                    <div class="col-md-6">

                        <label asp-for="TrangThai"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="TrangThai"
                                class="form-select">

                            <option value="Trống">
                                Trống
                            </option>

                            <option value="Đã thuê">
                                Đã thuê
                            </option>

                        </select>

                        <span asp-validation-for="TrangThai"
                              class="text-danger small">
                        </span>

                    </div>

                    
                    @if (User.IsInRole("admin"))
                    {
                        <div class="mb-3">
                            <label asp-for="ChuTroId" class="form-label">
                                Chủ trọ
                            </label>

                            <select asp-for="ChuTroId"
                                    class="form-select"
                                    asp-items="ViewBag.ChuTroId">
                            </select>
                        </div>
                    }

                    
                    <div class="col-12">

                        <label asp-for="MoTa"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="MoTa"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Nhập mô tả phòng..."></textarea>

                        <span asp-validation-for="MoTa"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                
                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">

                        💾 Lưu phòng

                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        Quay lại

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}