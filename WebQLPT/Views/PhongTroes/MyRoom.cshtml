@model WebQLPT.Models.KhachThue

@{
    ViewData["Title"] = "Phòng của tôi";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-house-door-fill me-2"></i>
            Phòng của tôi
        </h2>

        <p class="text-muted mb-0">
            Thông tin phòng đang thuê của bạn
        </p>

    </div>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <div class="row g-4">

            <!-- Thông tin phòng -->
            <div class="col-lg-6">

                <div class="border rounded-4 p-4 h-100">

                    <h3 class="fw-bold text-primary mb-4">

                        <i class="bi bi-building me-2"></i>
                        @Model.PhongTro?.TenPhong

                    </h3>

                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            Giá phòng
                        </div>

                        <div class="fs-3 fw-bold text-danger">

                            @Model.PhongTro?.Gia.ToString("N0",
                                     new System.Globalization.CultureInfo("vi-VN")) đ

                        </div>

                    </div>

                    <div>

                        <div class="text-muted small mb-1">
                            Trạng thái
                        </div>

                        @if (Model.PhongTro?.TrangThai == "Đã thuê")
                        {
                            <span class="badge bg-success px-3 py-2">
                                Đang thuê
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                @Model.PhongTro?.TrangThai
                            </span>
                        }

                    </div>

                </div>

            </div>

            <!-- Thông tin chủ trọ -->
            <div class="col-lg-6">

                <div class="border rounded-4 p-4 h-100">

                    <h5 class="fw-bold mb-4">

                        <i class="bi bi-person-badge-fill me-2"></i>
                        Thông tin chủ trọ

                    </h5>

                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            Chủ trọ
                        </div>

                        <div class="fw-semibold fs-5">
                            @Model.PhongTro?.ChuTro?.TenChuTro
                        </div>

                    </div>

                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            Số điện thoại
                        </div>

                        <div class="fw-semibold">
                            @Model.PhongTro?.ChuTro?.SoDienThoai
                        </div>

                    </div>

                    <div>

                        <div class="text-muted small mb-1">
                            Địa chỉ
                        </div>

                        <div class="fw-semibold">
                            @Model.PhongTro?.ChuTro?.DiaChi
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>