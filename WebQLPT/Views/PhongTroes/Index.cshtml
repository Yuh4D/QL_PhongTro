@model IEnumerable<WebQLPT.Models.PhongTro>

@{
    ViewData["Title"] = "Danh sách phòng trọ";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-building"> </i>
             Danh sách phòng trọ
        </h2>

        <p class="text-muted mb-0">
            Quản lý toàn bộ phòng trọ trong hệ thống
        </p>
    </div>

    <a asp-action="Create"
           class="btn btn-success">
        <i class="bi bi-plus-circle"></i>

         Thêm phòng

    </a>

</div>


<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="row g-2">

            <div class="col-md-10">

                <input type="text"
                       name="keyword"
                       class="form-control"
                       placeholder="Tìm theo tên phòng..." />

            </div>

            <div class="col-md-2 d-grid">

                <button type="submit"
                        class="btn btn-primary">

                    🔍 Tìm kiếm

                </button>

            </div>

        </form>

    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark text-center">

                <tr>
                    <th>Tên phòng</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th>Mô tả</th>
                    <th>Chủ trọ</th>
                    <th width="220px">Chức năng</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @item.TenPhong
                        </td>

                        <td class="text-danger fw-bold">

                            @item.Gia.ToString("N0",
                                     new System.Globalization.CultureInfo("vi-VN")) đ

                        </td>

                        <td class="text-center">

                            @if (item.TrangThai == "Trống")
                            {
                                <span class="badge bg-success">
                                    Trống
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Đã thuê
                                </span>
                            }

                        </td>

                        <td>

                            @(item.MoTa != null && item.MoTa.Length > 60
                                ? item.MoTa.Substring(0, 60) + "..."
                                : item.MoTa)

                        </td>

                        <td>
                            @item.ChuTro?.TenChuTro
                        </td>

                        <td class="text-center">

                            <div class="d-flex justify-content-center gap-2">

                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm text-white">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>