@model WebQLPT.Models.PhongTro

@{
    ViewData["Title"] = "Xóa phòng";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold text-danger">
            🗑 Xóa phòng trọ
        </h2>

        <p class="text-muted">
            Hành động này không thể hoàn tác
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-warning">

                Bạn có chắc muốn xóa phòng:

                <strong>
                    @Model.TenPhong
                </strong> ?

            </div>

            <div class="row g-4 mb-4">

                <div class="col-md-6">

                    <label class="text-muted small">
                        Giá phòng
                    </label>

                    <div class="fw-bold text-danger">

                        @Model.Gia.ToString("N0",
                                 new System.Globalization.CultureInfo("vi-VN")) đ

                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted small">
                        Trạng thái
                    </label>

                    <div>
                        @Model.TrangThai
                    </div>

                </div>

            </div>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">

                        🗑 Xóa phòng

                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        Hủy

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>