@model IEnumerable<WebQLPT.Models.HopDong>

@{
    ViewData["Title"] = "Danh sách hợp đồng";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-text"></i>
            Danh sách hợp đồng
        </h2>

        <p class="text-muted mb-0">
            Quản lý hợp đồng thuê phòng trong hệ thống
        </p>
    </div>

    <a asp-action="Create"
           class="btn btn-success">

        <i class="bi bi-plus-circle"></i>
        Tạo hợp đồng

    </a>

</div>

<form method="get"
      asp-action="Index"
      class="row g-2 mb-4">

    <div class="col-md-4">

        <input type="text"
               name="keyword"
               class="form-control"
               placeholder="Tìm hợp đồng..." />

    </div>

    <div class="col-auto">

        <button type="submit"
                class="btn btn-primary">
			
            🔍 Tìm kiếm

        </button>

    </div>

</form>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead class="table-dark">

                <tr>
                    <th>Phòng</th>
                    <th>Khách thuê</th>
                    <th>Ngày bắt đầu</th>
                    <th>Ngày kết thúc</th>
                    <th>Tiền cọc</th>
                    <th width="220">Thao tác</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            <i class="bi bi-building me-1 text-primary"></i>
                            @item.PhongTro?.TenPhong
                        </td>

                        <td>
                            <i class="bi bi-person-fill me-1 text-success"></i>
                            @item.KhachThue?.TenKhach
                        </td>

                        <td>
                            @item.NgayBatDau.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.NgayKetThuc.ToString("dd/MM/yyyy")
                        </td>

                        <td class="fw-bold text-danger">
                            @item.TienCoc.ToString("N0",
                                     new System.Globalization.CultureInfo("vi-VN")) đ
                        </td>

                        <td>

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-action="ExportPdf"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                    <i class="bi bi-file-earmark-pdf"></i>

                                </a>

                                @if(!User.IsInRole("khachthue"))
                                {
                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </a>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>