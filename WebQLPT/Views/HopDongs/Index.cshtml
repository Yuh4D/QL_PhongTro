@model IEnumerable<WebQLPT.Models.HopDong>

@{
    ViewData["Title"] = "Danh sách hợp đồng";
}

<h2 class="mb-4">📄 Danh sách hợp đồng</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Tạo hợp đồng</a>

<table class="table table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Phòng</th>
            <th>Khách thuê</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Tiền cọc</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PhongTro?.TenPhong</td>
                <td>@item.KhachThue?.TenKhach</td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@@item.TienCoc.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem</a>

                    <a asp-action="ExportPdf" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">PDF</a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-outline-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>