@model WebQLPT.Models.HopDong

@{
    ViewData["Title"] = "Cập nhật hợp đồng";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            ✏️ Cập nhật hợp đồng
        </h2>

        <p class="text-muted mb-0">
            Chỉnh sửa thông tin hợp đồng thuê phòng
        </p>
    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">
        ← Quay lại
    </a>

</div>

<div class="card shadow border-0 rounded-4">

    <div class="card-body p-4">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="PhongTroId"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="PhongTroId"
                            class="form-select"
                            asp-items="ViewBag.PhongTroId">
                    </select>

                    <span asp-validation-for="PhongTroId"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="KhachThueId"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="KhachThueId"
                            class="form-select"
                            asp-items="ViewBag.KhachThueId">
                    </select>

                    <span asp-validation-for="KhachThueId"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="NgayBatDau"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="NgayBatDau"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayBatDau"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="NgayKetThuc"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="NgayKetThuc"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayKetThuc"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="TienCoc"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TienCoc"
                           class="form-control" />

                    <span asp-validation-for="TienCoc"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="DieuKhoanThem"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="DieuKhoanThem"
                              rows="5"
                              class="form-control"
                                  placeholder="Nhập điều khoản thêm...">
                    </textarea>

                </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        💾 Lưu thay đổi

                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        Hủy

                    </a>

                </div>

            </form>

        </div>

    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }