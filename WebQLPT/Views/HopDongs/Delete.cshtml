@model WebQLPT.Models.HopDong

@{
    ViewData["Title"] = "Xóa hợp đồng";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

   
    <div>

        <h2 class="fw-bold text-danger mb-1">
            🗑️ Xóa hợp đồng
        </h2>

        <p class="text-muted mb-0">
            Xác nhận trước khi xóa hợp đồng
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        ← Quay lại

    </a>
    

</div>

<div class="card shadow border-0 rounded-4">

    <div class="card-body p-4">

        <div class="alert alert-warning">

            Bạn có chắc chắn muốn xóa hợp đồng này không?

        </div>

        <div class="row g-4">

            <div class="col-md-6">

                <div class="border rounded-3 p-3 h-100">

                    <p class="text-muted mb-1">
                        Phòng
                    </p>

                    <h5 class="fw-bold">
                        @Model.PhongTro?.TenPhong
                    </h5>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded-3 p-3 h-100">

                    <p class="text-muted mb-1">
                        Khách thuê
                    </p>

                    <h5 class="fw-bold">
                        @Model.KhachThue?.TenKhach
                    </h5>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded-3 p-3 h-100">

                    <p class="text-muted mb-1">
                        Ngày bắt đầu
                    </p>

                    <h5 class="fw-bold">
                        @Model.NgayBatDau.ToString("dd/MM/yyyy")
                    </h5>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded-3 p-3 h-100">

                    <p class="text-muted mb-1">
                        Tiền cọc
                    </p>

                    <h5 class="fw-bold text-danger">

                        @Model.TienCoc.ToString("N0",
                                 new System.Globalization.CultureInfo("vi-VN")) đ

                    </h5>

                </div>

            </div>

        </div>

        <form asp-action="Delete"
              class="mt-4">

            <input type="hidden"
                   asp-for="Id" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-danger">

                    🗑️ Xóa hợp đồng

                </button>

                <a asp-action="Index"
                       class="btn btn-outline-secondary">

                    Hủy

                </a>

            </div>

        </form>

    </div>
  

</div>
