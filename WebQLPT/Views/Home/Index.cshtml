@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutAdmin";
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 me-2"></i>
            Dashboard
        </h2>

        <p class="text-muted mb-0">

            @if (User.IsInRole("admin"))
            {
                <span>Tổng quan toàn hệ thống quản lý phòng trọ</span>
            }
            else if (User.IsInRole("chutro"))
            {
                <span>Quản lý phòng trọ và khách thuê của bạn</span>
            }
            else
            {
                <span>Thông tin thuê phòng và hóa đơn của bạn</span>
            }

        </p>

    </div>

    <span class="badge bg-dark fs-6 px-3 py-2">
        @DateTime.Now.ToString("dd/MM/yyyy")
    </span>

</div>

<!-- WELCOME -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">

    <div class="card-body p-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <h3 class="fw-bold mb-2">
                    Xin chào @User.Identity?.Name 👋
                </h3>

                <p class="text-muted mb-0">
                    Chúc bạn có một ngày làm việc hiệu quả với hệ thống Room-Connect.
                </p>

            </div>

            <div class="col-lg-4 text-end d-none d-lg-block">

                <i class="bi bi-buildings display-1 text-primary opacity-50"></i>

            </div>

        </div>

    </div>

</div>

<!-- ================= ADMIN ================= -->
@if (User.IsInRole("admin"))
{
    <div class="row g-4 mb-4">

        <!-- KHÁCH THUÊ -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Khách thuê
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.SoKhach
                            </h3>

                        </div>

                        <div class="display-5 text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- PHÒNG -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Phòng trọ
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.SoPhong
                            </h3>

                        </div>

                        <div class="display-5 text-success">
                            <i class="bi bi-building"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- HÓA ĐƠN -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Hóa đơn
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.SoHoaDon
                            </h3>

                        </div>

                        <div class="display-5 text-warning">
                            <i class="bi bi-receipt"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- CHỦ TRỌ -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Chủ trọ
                            </p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.SoChuTro
                            </h3>

                        </div>

                        <div class="display-5 text-danger">
                            <i class="bi bi-house-fill"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    
    <div class="row g-4">

        <!-- PHÒNG -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-door-open-fill me-2"></i>
                        Trạng thái phòng
                    </h5>

                    <div class="mb-3">

                        <div class="d-flex justify-content-between mb-1">

                            <span>Phòng trống</span>

                            <span class="fw-bold text-success">
                                @ViewBag.PhongTrong
                            </span>

                        </div>

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width: 70%">
                            </div>

                        </div>

                    </div>

                    <div>

                        <div class="d-flex justify-content-between mb-1">

                            <span>Đã thuê</span>

                            <span class="fw-bold text-primary">
                                @ViewBag.PhongDaThue
                            </span>

                        </div>

                        <div class="progress">

                            <div class="progress-bar bg-primary"
                                 style="width: 60%">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- QUICK ACTION -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-lightning-fill me-2"></i>
                        Thao tác nhanh
                    </h5>

                    <div class="d-grid gap-2">

                        <a asp-controller="PhongTroes"
                               asp-action="Create"
                               class="btn btn-primary">

                            <i class="bi bi-building-add me-2"></i>
                            Thêm phòng trọ

                        </a>

                        <a asp-controller="KhachThues"
                               asp-action="Create"
                               class="btn btn-success">

                            <i class="bi bi-person-plus-fill me-2"></i>
                            Thêm khách thuê

                        </a>

                        <a asp-controller="HoaDons"
                               asp-action="Create"
                               class="btn btn-warning text-dark">

                            <i class="bi bi-receipt-cutoff me-2"></i>
                            Tạo hóa đơn

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- THÔNG BÁO -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-bell-fill me-2"></i>
                        Thông báo
                    </h5>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item px-0">
                            Hệ thống đang hoạt động ổn định
                        </li>

                        <li class="list-group-item px-0">
                            Chào mừng bạn quay lại 🎉
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>
}

<!-- ================= CHỦ TRỌ ================= -->
@if (User.IsInRole("chutro"))
{
    <div class="row g-4">

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-building text-primary display-5"></i>

                    <h3 class="fw-bold mt-3">
                        @ViewBag.SoPhong
                    </h3>

                    <p class="text-muted mb-0">
                        Tổng phòng
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-door-open text-success display-5"></i>

                    <h3 class="fw-bold mt-3">
                        @ViewBag.PhongDaThue
                    </h3>

                    <p class="text-muted mb-0">
                        Phòng đã thuê
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-receipt-cutoff text-danger display-5"></i>

                    <h3 class="fw-bold mt-3">
                        @ViewBag.HoaDonChuaThanhToan
                    </h3>

                    <p class="text-muted mb-0">
                        Hóa đơn chưa thanh toán
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack text-success display-5"></i>

                    <h3 class="fw-bold mt-3 text-danger">
                        @(((decimal)ViewBag.DoanhThu).ToString("N0")) đ
                    </h3>

                    <p class="text-muted mb-0">
                        Doanh thu
                    </p>

                </div>

            </div>

        </div>

    </div>
}

<!-- ================= KHÁCH THUÊ ================= -->
@if (User.IsInRole("khachthue"))
{
    <div class="row g-4">

        <!-- PHÒNG -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-house-fill text-primary display-5"></i>

                    <h5 class="fw-bold mt-3">
                        @ViewBag.TenPhong
                    </h5>

                    <p class="text-muted mb-0">
                        Phòng đang thuê
                    </p>

                </div>

            </div>

        </div>

        <!-- GIÁ -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack text-success display-5"></i>

                    <h5 class="fw-bold mt-3 text-danger">

                        @(ViewBag.GiaPhong > 0
                            ? $"{ViewBag.GiaPhong:N0} đ"
                            : "Chưa có dữ liệu")

                    </h5>

                    <p class="text-muted mb-0">
                        Giá phòng
                    </p>

                </div>

            </div>

        </div>

        <!-- HỢP ĐỒNG -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-calendar-event text-warning display-5"></i>

                    <h5 class="fw-bold mt-3">

                        @(ViewBag.HanHopDong != null
                            ? ((DateTime)ViewBag.HanHopDong)
                                .ToString("dd/MM/yyyy")
                            : "Chưa có")

                    </h5>

                    <p class="text-muted mb-0">
                        Hạn hợp đồng
                    </p>

                </div>

            </div>

        </div>

        <!-- HÓA ĐƠN -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <i class="bi bi-receipt text-danger display-5"></i>

                    <h3 class="fw-bold mt-3">
                        @ViewBag.HoaDonChuaThanhToan
                    </h3>

                    <p class="text-muted mb-0">
                        Hóa đơn chưa thanh toán
                    </p>

                </div>

            </div>

        </div>

    </div>
}
