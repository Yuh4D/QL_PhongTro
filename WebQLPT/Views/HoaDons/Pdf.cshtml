@model WebQLPT.Models.HoaDon
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
            body {
                font-family: Arial;
                font-size: 14px;
            }

            .container {
                width: 700px;
                margin: auto;
            }

            .title {
                text-align: center;
                font-size: 22px;
                font-weight: bold;
                margin-bottom: 20px;
            }

            .info {
                margin-bottom: 15px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            table, th, td {
                border: 1px solid black;
            }

            th, td {
                padding: 8px;
                text-align: center;
            }

            .left {
                text-align: left;
            }

            .total {
                text-align: right;
                font-size: 16px;
                font-weight: bold;
                margin-top: 10px;
            }

            .sign {
                margin-top: 40px;
                display: flex;
                justify-content: space-between;
            }

                .sign div {
                    text-align: center;
                }
    </style>
</head>

<body>
    <div class="container">

        <div class="title">HÓA ĐƠN THANH TOÁN</div>

        <div class="info">
            <p><strong>Chủ trọ:</strong> @Model.PhongTro?.ChuTro?.TenChuTro</p>
            <p><strong>Phòng:</strong> @Model.PhongTro?.TenPhong</p>
            <p><strong>Khách thuê:</strong> @Model.KhachThue?.TenKhach</p>
            <p><strong>Ngày tạo:</strong> @Model.NgayTao.ToString("dd/MM/yyyy")</p>
            <p><strong>Hạn thanh toán:</strong> @Model.HanThanhToan.ToString("dd/MM/yyyy")</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Nội dung</th>
                    <th>Đơn giá</th>
                    <th>SL</th>
                    <th>HS</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }

                @foreach (var item in Model.HoaDonChiTiets)
                {
                    <tr>
                        <td>@stt</td>
                        <td class="left">@item.NoiDung</td>
                        <td>@item.DonGia.ToString("N0")</td>
                        <td>@item.SoLuong</td>
                        <td>@item.HeSo</td>
                        <td>@item.ThanhTien.ToString("N0")</td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>

        <div class="total">
            Tổng tiền: @Model.TongTien.ToString("N0") VNĐ
        </div>

        <div class="sign">
            <div>
                Chủ trọ<br /><br /><br />
                (Ký tên)
            </div>

            <div>
                Khách thuê<br /><br /><br />
                (Ký tên)
            </div>
        </div>

    </div>
</body>
</html>