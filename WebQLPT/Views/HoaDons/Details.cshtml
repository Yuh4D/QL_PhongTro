@model WebQLPT.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "_LayoutAdmin";
}

<div class="container">

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-5">

            <div class="text-center mb-4">

                <h2 class="fw-bold">
                    HÓA ĐƠN THÁNG @Model.Thang/@Model.Nam
                </h2>

                <p class="text-muted">
                    Ngày tạo:
                    @Model.NgayTao.ToString("dd/MM/yyyy")
                </p>

            </div>

            <hr />

            <div class="row mb-4">

                <div class="col-md-6">

                    <strong>Khách thuê:</strong>

                    <div>
                        @Model.KhachThue?.TenKhach
                    </div>

                </div>

                <div class="col-md-6">

                    <strong>Phòng:</strong>

                    <div>
                        @Model.PhongTro?.TenPhong
                    </div>

                </div>

            </div>

            <table class="table table-bordered">

                <thead class="table-dark">

                    <tr>
                        <th>Nội dung</th>
                        <th class="text-end">
                            Thành tiền
                        </th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Tiền phòng</td>
                        <td class="text-end">
                            @Model.TienPhong.ToString("N0")
                        </td>
                    </tr>

                    <tr>
                        <td>
                            Tiền điện
                            (@Model.ChiSoDienCu →
                            @Model.ChiSoDienMoi)
                        </td>

                        <td class="text-end">
                            @Model.TienDien.ToString("N0")
                        </td>
                    </tr>

                    <tr>
                        <td>
                            Tiền nước
                            (@Model.ChiSoNuocCu →
                            @Model.ChiSoNuocMoi)
                        </td>

                        <td class="text-end">
                            @Model.TienNuoc.ToString("N0")
                        </td>
                    </tr>

                </tbody>

                <tfoot>

                    <tr class="table-warning">

                        <th>TỔNG CỘNG</th>

                        <th class="text-end text-danger">

                            @Model.TongTien.ToString("N0") VNĐ

                        </th>

                    </tr>

                </tfoot>

            </table>

            <div class="mt-4">

                @if (Model.TrangThai == "Đã thanh toán")
                {
                    <span class="badge bg-success fs-6">
                        Đã thanh toán
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">
                        Chưa thanh toán
                    </span>
                }

            </div>

            <div class="mt-4 d-flex gap-2">

                @if (User.IsInRole("khachthue"))
                {
                    <a asp-action="MyBills"
                           class="btn btn-secondary">
                        Quay lại
                    </a>
                }
                else
                {
                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Quay lại
                    </a>
                }

                <a asp-action="ExportPdf"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">

                    Xuất PDF

                </a>

            </div>

        </div>

    </div>

</div>