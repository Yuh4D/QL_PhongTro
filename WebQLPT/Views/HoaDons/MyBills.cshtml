@model IEnumerable<WebQLPT.Models.HoaDon>

@{
    ViewData["Title"] = "Hóa đơn của tôi";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff me-2"></i>
            Hóa đơn của tôi
        </h2>

        <p class="text-muted mb-0">
            Theo dõi các khoản phí và trạng thái thanh toán
        </p>
    </div>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark text-center">

                    <tr>
                        <th>Tháng</th>
                        <th>Phòng</th>
                        <th>Tiền phòng</th>
                        <th>Điện</th>
                        <th>Nước</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th width="180">Thao tác</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.OrderByDescending(x => x.Nam)
                                                                   .ThenByDescending(x => x.Thang))
                    {
                        <tr>

                            <td class="text-center">

                                <span class="badge bg-primary fs-6">
                                    @item.Thang/@item.Nam
                                </span>

                            </td>

                            <td>

                                <div class="fw-semibold">
                                    @item.PhongTro?.TenPhong
                                </div>

                            </td>

                            <td>

                                <span class="text-primary fw-bold">
                                    @item.TienPhong.ToString("N0")
                                </span> đ

                            </td>

                            <td>

                                <div class="fw-bold text-warning">

                                    @item.TienDien.ToString("N0") đ

                                </div>

                                <small class="text-muted">

                                    @item.ChiSoDienCu →
                                    @item.ChiSoDienMoi

                                    <br />

                                    Tiêu thụ:
                                    @(item.ChiSoDienMoi - item.ChiSoDienCu)

                                </small>

                            </td>

                            <td>

                                <div class="fw-bold text-info">

                                    @item.TienNuoc.ToString("N0") đ

                                </div>

                                <small class="text-muted">

                                    @item.ChiSoNuocCu →
                                    @item.ChiSoNuocMoi

                                    <br />

                                    Tiêu thụ:
                                    @(item.ChiSoNuocMoi - item.ChiSoNuocCu)

                                </small>

                            </td>

                            <td>

                                <span class="text-danger fw-bold fs-5">

                                    @item.TongTien.ToString("N0")

                                </span> đ

                            </td>

                            <td>

                                @if (item.TrangThai == "Đã thanh toán")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock"></i>
                                        Chưa thanh toán
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-2 justify-content-center">

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    @if (item.TrangThai != "Đã thanh toán")
                                    {
                                        <form asp-controller="VnPay"
                                              asp-action="CreatePaymentUrl"
                                              method="post">

                                            <input type="hidden"
                                                   name="hoaDonId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">

                                                <i class="bi bi-credit-card"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm"
                                                disabled>

                                            <i class="bi bi-check-circle"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
            icon: 'success',
            title: 'Thành công',
            text: '@TempData["Success"]'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
            icon: 'error',
            title: 'Lỗi',
            text: '@TempData["Error"]'
            });
        </script>
    }
}