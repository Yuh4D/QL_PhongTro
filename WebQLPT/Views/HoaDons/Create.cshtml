@model WebQLPT.Models.HoaDon

@{
    ViewData["Title"] = "Tạo hóa đơn";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff me-2"></i>
            Tạo hóa đơn
        </h2>

        <p class="text-muted mb-0">
            Tạo và quản lý chi tiết hóa đơn phòng trọ
        </p>
    </div>

</div>

<form asp-action="Create" method="post">

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Phòng trọ
                    </label>

                    <select asp-for="PhongTroId"
                            class="form-select"
                            asp-items="ViewBag.PhongTroId">
                    </select>

                </div>

                <div class="col-md-4">

                    <label asp-for="NgayTao"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="NgayTao"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <label asp-for="HanThanhToan"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="HanThanhToan"
                           type="date"
                           class="form-control" />

                </div>

            </div>

        </div>

    </div>
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label>Chỉ số điện mới</label>

                    <input asp-for="ChiSoDienMoi"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Chỉ số nước mới</label>

                    <input asp-for="ChiSoNuocMoi"
                           class="form-control" />
                </div>

            </div>

            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    Tạo hóa đơn

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Quay lại

                </a>

            </div>

        </div>

    </div>
    

    </div>

</form>

@section Scripts {

    <script>

        let index = 0;

        function addRow() {

            let row = `
            <tr>

                <td>
                    <input name="ChiTiets[${index}].NoiDung"
                           class="form-control"
                           placeholder="Nhập nội dung..." />
                </td>

                <td>
                    <input name="ChiTiets[${index}].DonGia"
                           class="form-control"
                           type="number"
                           oninput="tinhTien(this)" />
                </td>

                <td>
                    <input name="ChiTiets[${index}].SoLuong"
                           class="form-control"
                           type="number"
                           oninput="tinhTien(this)" />
                </td>

                <td>
                    <input name="ChiTiets[${index}].HeSo"
                           value="1"
                           class="form-control"
                           type="number"
                           oninput="tinhTien(this)" />
                </td>

                <td class="thanhTien fw-bold text-danger">
                    0
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            onclick="removeRow(this)">

                        <i class="bi bi-trash"></i>

                    </button>
                </td>

            </tr>`;

            document.querySelector("#detailTable tbody")
                .insertAdjacentHTML("beforeend", row);

            index++;
        }

        function tinhTien(el) {

            let row = el.closest("tr");

            let donGia =
                parseFloat(
                    row.children[1].children[0].value
                ) || 0;

            let soLuong =
                parseFloat(
                    row.children[2].children[0].value
                ) || 0;

            let heSo =
                parseFloat(
                    row.children[3].children[0].value
                ) || 1;

            let thanhTien =
                donGia * soLuong * heSo;

            row.querySelector(".thanhTien")
                .innerText =
                thanhTien.toLocaleString("vi-VN");

            tinhTong();
        }

        function tinhTong() {

            let total = 0;

            document.querySelectorAll(".thanhTien")
                .forEach(td => {

                    total += parseFloat(
                        td.innerText.replace(/\./g, "")
                    ) || 0;
                });

            document.getElementById("tongTien")
                .innerText =
                total.toLocaleString("vi-VN");
        }

        function removeRow(btn) {

            btn.closest("tr").remove();

            tinhTong();
        }

        function themDien() {

            let moi = prompt("Chỉ số điện mới:");
            let cu = prompt("Chỉ số điện cũ:");

            let soLuong = moi - cu;

            addCustomRow(
                "Tiền điện",
                3000,
                soLuong
            );
        }

        function themNuoc() {

            let moi = prompt("Chỉ số nước mới:");
            let cu = prompt("Chỉ số nước cũ:");

            let soLuong = moi - cu;

            addCustomRow(
                "Tiền nước",
                15000,
                soLuong
            );
        }

        function addCustomRow(
            noiDung,
            donGia,
            soLuong
        ) {

            let thanhTien =
                donGia * soLuong;

            let row = `
            <tr>

                <td>
                    <input name="ChiTiets[${index}].NoiDung"
                           value="${noiDung}"
                           class="form-control" />
                </td>

                <td>
                    <input name="ChiTiets[${index}].DonGia"
                           value="${donGia}"
                           class="form-control"
                           type="number" />
                </td>

                <td>
                    <input name="ChiTiets[${index}].SoLuong"
                           value="${soLuong}"
                           class="form-control"
                           type="number" />
                </td>

                <td>
                    <input name="ChiTiets[${index}].HeSo"
                           value="1"
                           class="form-control"
                           type="number" />
                </td>

                <td class="thanhTien fw-bold text-danger">
                    ${thanhTien.toLocaleString("vi-VN")}
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            onclick="removeRow(this)">

                        <i class="bi bi-trash"></i>

                    </button>
                </td>

            </tr>`;

            document.querySelector("#detailTable tbody")
                .insertAdjacentHTML("beforeend", row);

            index++;

            tinhTong();
        }

    </script>
}