@model WebQLPT.Models.HoaDon

<h2 class="mb-4">🧾 Tạo hóa đơn</h2>

<form asp-action="Create" method="post">

    <div class="row">
        <div class="col-md-4">
            <label>Phòng</label>
            <select asp-for="PhongTroId" class="form-control" asp-items="ViewBag.PhongTroId"></select>
        </div>

        <div class="col-md-4">
            <label>Ngày tạo</label>
            <input asp-for="NgayTao" type="date" class="form-control" />
        </div>

        <div class="col-md-4">
            <label>Hạn thanh toán</label>
            <input asp-for="HanThanhToan" type="date" class="form-control" />
        </div>
    </div>

    <hr />

    <h4>Chi tiết hóa đơn</h4>

    <table class="table table-bordered table-hover" id="detailTable">
        <thead class="table-dark">
            <tr>
                <th>Nội dung</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Hệ số</th>
                <th>Thành tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <h4 class="text-end">Tổng tiền: <span id="tongTien">0</span> VNĐ</h4>

    <button type="button" class="btn btn-success" onclick="addRow()">+ Thêm dòng</button>
    <button type="button" class="btn btn-warning" onclick="themDien()">+ Tiền điện</button>
    <button type="button" class="btn btn-info" onclick="themNuoc()">+ Tiền nước</button>

    <br /><br />

    <button type="submit" class="btn btn-primary">Tạo hóa đơn</button>

</form>

@section Scripts {
    <script>
        let index = 0;

        function addRow() {
            let row = `
            <tr>
                <td><input name="ChiTiets[${index}].NoiDung" class="form-control" /></td>
                <td><input name="ChiTiets[${index}].DonGia" class="form-control" oninput="tinhTien(this)" /></td>
                <td><input name="ChiTiets[${index}].SoLuong" class="form-control" oninput="tinhTien(this)" /></td>
                <td><input name="ChiTiets[${index}].HeSo" value="1" class="form-control" oninput="tinhTien(this)" /></td>
                <td class="thanhTien">0</td>
                <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button></td>
            </tr>`;
            document.querySelector("#detailTable tbody").insertAdjacentHTML("beforeend", row);
            index++;
        }

        function tinhTien(el) {
            let row = el.closest("tr");

            let donGia = parseFloat(row.children[1].children[0].value) || 0;
            let soLuong = parseFloat(row.children[2].children[0].value) || 0;
            let heSo = parseFloat(row.children[3].children[0].value) || 1;

            let thanhTien = donGia * soLuong * heSo;

            row.querySelector(".thanhTien").innerText = thanhTien.toLocaleString();

            tinhTong();
        }

        function tinhTong() {
            let total = 0;
            document.querySelectorAll(".thanhTien").forEach(td => {
                total += parseFloat(td.innerText.replace(/,/g, "")) || 0;
            });
            document.getElementById("tongTien").innerText = total.toLocaleString();
        }

        function removeRow(btn) {
            btn.closest("tr").remove();
            tinhTong();
        }

        function themDien() {
            let moi = prompt("Chỉ số điện mới:");
            let cu = prompt("Chỉ số điện cũ:");
            let soLuong = moi - cu;
            addCustomRow("Tiền điện", 3000, soLuong);
        }

        function themNuoc() {
            let moi = prompt("Chỉ số nước mới:");
            let cu = prompt("Chỉ số nước cũ:");
            let soLuong = moi - cu;
            addCustomRow("Tiền nước", 15000, soLuong);
        }

        function addCustomRow(noiDung, donGia, soLuong) {
            let row = `
            <tr>
                <td><input name="ChiTiets[${index}].NoiDung" value="${noiDung}" class="form-control" /></td>
                <td><input name="ChiTiets[${index}].DonGia" value="${donGia}" class="form-control" /></td>
                <td><input name="ChiTiets[${index}].SoLuong" value="${soLuong}" class="form-control" /></td>
                <td><input name="ChiTiets[${index}].HeSo" value="1" class="form-control" /></td>
                <td class="thanhTien">${(donGia * soLuong).toLocaleString()}</td>
                <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button></td>
            </tr>`;
            document.querySelector("#detailTable tbody").insertAdjacentHTML("beforeend", row);
            index++;
            tinhTong();
        }
    </script>
}