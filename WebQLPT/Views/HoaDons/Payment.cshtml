@model WebQLPT.Models.HoaDon

@{
    ViewData["Title"] = "Thanh toán hóa đơn";
    Layout = "_LayoutAdmin";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <i class="bi bi-credit-card-2-front display-3 text-primary"></i>

                        <h2 class="fw-bold mt-3">
                            Thanh toán hóa đơn
                        </h2>

                        <p class="text-muted">
                            Mô phỏng thanh toán cho đồ án
                        </p>

                    </div>

                    <hr />

                    <div class="mb-3">

                        <label class="fw-semibold">
                            Phòng
                        </label>

                        <div>
                            @Model.PhongTro?.TenPhong
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="fw-semibold">
                            Khách thuê
                        </label>

                        <div>
                            @Model.KhachThue?.TenKhach
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="fw-semibold">
                            Tổng tiền
                        </label>

                        <div class="text-danger fs-4 fw-bold">

                            @Model.TongTien.ToString("N0") VNĐ

                        </div>

                    </div>

                    <div class="mb-4">

                        <label class="fw-semibold">
                            Phương thức thanh toán
                        </label>

                        <select class="form-select">

                            <option>Ví điện tử</option>
                            <option>Internet Banking</option>
                            <option>QR Banking</option>

                        </select>

                    </div>

                    <form asp-controller="VnPay"
                          asp-action="CreatePaymentUrl"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="hoaDonId"
                               value="@Model.Id" />

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                <i class="bi bi-wallet2 me-2"></i>
                                Thanh toán bằng VNPay

                            </button>

                        </div>

                    </form>

                    <div class="text-center mt-3">

                        <a asp-action="Index"
                               class="btn btn-outline-secondary">

                            Quay lại

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>